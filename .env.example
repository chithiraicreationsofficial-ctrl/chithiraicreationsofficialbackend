# Server
PORT=8000
NODE_ENV=development

# MongoDB Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT Secrets
JWT_SECRET=your_super_secure_jwt_secret_here
JWT_EXPIRES_IN=1h
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Admin 2FA
ADMIN_2FA_CODE=123456

# OTP Configuration
OTP_EXPIRY_MINUTES=10
MAX_TICKETS=500

# Email Service (SMTP)
FROM_NAME=Chithirai Creations
FROM_EMAIL=chithiraicreationsofficial@gmail.com
ADMIN_EMAIL=admin@chithiraicreations.com
EMAIL_HOST=mail.smtp2go.com
EMAIL_USERNAME=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_PORT=2525

# Aiven PostgreSQL Database
PG_HOST=pg-1f2f3255-chithiraicreationsofficial.b.aivencloud.com
PG_PORT=10254
PG_DATABASE=defaultdb
PG_USER=avnadmin
PG_PASSWORD=your_aiven_postgres_password_here
PG_SSL=true
